{
  "manifest_version": 3,
  "name": "QuickHighlight Utility",
  "version": "1.2",
  "description": "Highlights web text in custom colors and exports findings to a text file.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
